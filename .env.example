# Local mode works with no secrets. Copy to .env only when you want live integrations.

FINOPS_ENV=local

# Storage
# Default: SQLite at data/finops.db
# For Docker/Postgres:
# FINOPS_DATABASE_URL=postgresql://finops:finops@localhost:5432/finops

# AWS live ingestion
FINOPS_AWS_PROFILE=
FINOPS_AWS_REGIONS=us-east-1
FINOPS_AWS_ACCOUNT_ID=personal-aws

# Terraform source
FINOPS_TERRAFORM_PATH=/Users/aayushpandey/Documents/Codex/2026-07-01/i-g/work/finops-agent/demo/terraform/main.tf
FINOPS_TERRAFORM_REPO_PATH=demo/terraform/main.tf

# GitHub PR creation. If unset, the agent writes local PR artifacts instead.
FINOPS_GITHUB_TOKEN=
FINOPS_GITHUB_REPO=
FINOPS_GITHUB_BASE_BRANCH=main
FINOPS_GITHUB_BRANCH_PREFIX=finops
FINOPS_GITHUB_DRAFT_PR=true
FINOPS_REQUIRE_GITHUB_FOR_LIVE=true

# Slack approval notifications. If unset, the agent stores a local approval message.
FINOPS_SLACK_CHANNEL=#finops-approvals
FINOPS_SLACK_WEBHOOK_URL=

# Optional real LLM review. If unset, the local deterministic reviewer is used.
OPENAI_API_KEY=
FINOPS_OPENAI_MODEL=gpt-4.1-mini
